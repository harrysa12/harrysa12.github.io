---
import "../styles/global.css";
const { title = "Parceque", description = "Les pensées qui passent, celles qui restent." } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
